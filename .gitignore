# Dependencies
node_modules/

# Build output
dist/
dist-electron/
release/
out/
*.tsbuildinfo

# PyInstaller's scratch directory for the engine bundle. Scoped to `engine/`
# rather than a bare `build/`, which would swallow `apps/desktop/build/icon.png`
# — electron-builder's `buildResources`, and genuinely source.
# The bundle output itself lands in `engine/dist/`, already covered above.
engine/build/

# Local runtime data — SQLite catalogs are generated by ingest adapters, never source
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# Vendored datasets — every file is derived by a scripts/vendor-*.mjs run, so
# they are regenerable, large (~3.4 MB), and kept out of history.
#
# Two deliberate details:
#
#   - `**/data/*` ignores the directory's *contents*, not the directory. Git
#     cannot re-include anything beneath an excluded directory, so the plain
#     `data/` this replaces made the negation below impossible — and silently
#     swallowed `data/README.md`, which documents provenance and the CC-BY-SA
#     share-alike obligations, along with any source file that landed there.
#   - The `**/` prefix is required. A pattern containing a slash is anchored to
#     this file's directory, so a bare `data/*` would only match `/data/` at the
#     repo root and would stop ignoring the datasets entirely.
**/data/*
!**/data/README.md

# Cesium's runtime assets, staged into the renderer's public/ by the
# cesiumAssets plugin in electron.vite.config.ts. Copied out of node_modules on
# every dev/build start, so committing them would just duplicate a dependency.
apps/desktop/src/renderer/public/cesium/

# Ephemeris kernel — JPL DE440 is a ~114MB download, not something to commit
*.bsp

# Python (engine/)
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets — non-negotiable #6: API keys never leave the main process, never git
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/

# Coverage
coverage/
