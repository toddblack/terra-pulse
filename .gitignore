# Dependencies
node_modules/

# Build output
dist/
dist-electron/
release/
out/
*.tsbuildinfo

# Local runtime data — SQLite catalogs are generated by ingest adapters, never source
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
data/

# Ephemeris kernel — JPL DE440 is a ~114MB download, not something to commit
*.bsp

# Python (engine/)
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets — non-negotiable #6: API keys never leave the main process, never git
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/

# Coverage
coverage/
